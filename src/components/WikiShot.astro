---
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt: string;
  version: string;
  caption: string;
}

const { name, alt, version, caption } = Astro.props;
const images = import.meta.glob<ImageMetadata>('../assets/captures/*.webp', { eager: true, import: 'default' });
const photo = images[`../assets/captures/${name}.webp`];
if (!photo) throw new Error(`Unknown wiki capture: ${name}`);
---

<figure class="wiki-shot">
  <a href={photo.src} aria-label={alt}>
    <img src={photo.src} width={photo.width} height={photo.height} alt={alt} loading="lazy" decoding="async" />
  </a>
  <figcaption><span>{caption}</span><small>Doctor {version}</small></figcaption>
</figure>

<style>
  .wiki-shot {
    margin-inline: 0;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg-sidebar);
  }
  .wiki-shot a { display: block; line-height: 0; }
  .wiki-shot img { display: block; width: 100%; height: auto; max-height: 28rem; object-fit: contain; }
  .wiki-shot figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: .4rem 1rem;
    margin: 0;
    padding: .65rem .8rem;
    color: var(--sl-color-gray-2);
    font-size: .875rem;
    line-height: 1.45;
  }
  .wiki-shot small { color: var(--sl-color-text-accent); font-family: var(--sl-font-mono); white-space: nowrap; }
</style>
