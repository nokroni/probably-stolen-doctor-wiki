---
interface Props {
  language?: 'en' | 'zh-CN';
}

const { language = 'en' } = Astro.props;
const copy = language === 'zh-CN' ? {
  title: '1.0.0 床旁界面示意',
  chart: '病例',
  chartDetail: '点床边夹板，查看病史和记录',
  patient: '病人',
  patientDetail: '直接点身上的部位',
  monitor: '监护仪',
  monitorDetail: '接好探头后查看波形和读数',
  hint: '我',
  hintDetail: '拿不准下一步时看这里',
  actions: '底部操作栏',
  actionsDetail: '全身检查 · 停止操作 · 结案与剩余条件',
} : {
  title: '1.0.0 bedside diagram',
  chart: 'Patient chart',
  chartDetail: 'Select the clipboard for history and records',
  patient: 'Patient',
  patientDetail: 'Select a site directly on the patient',
  monitor: 'Monitor',
  monitorDetail: 'Connect sensors for waves and readings',
  hint: 'Me',
  hintDetail: 'Look here when you get stuck',
  actions: 'Bottom controls',
  actionsDetail: 'Body exam · Stop controls · Finish and remaining requirements',
};
---

<figure class="clinic-diagram" lang={language}>
  <figcaption>{copy.title}</figcaption>
  <div class="layout">
    <div class="chart tile">
      <div class="clipboard" aria-hidden="true"></div>
      <strong>{copy.chart}</strong>
      <span>{copy.chartDetail}</span>
    </div>
    <div class="patient tile">
      <div class="cot" aria-hidden="true">
        <i></i><i></i><i></i>
      </div>
      <strong>{copy.patient}</strong>
      <span>{copy.patientDetail}</span>
    </div>
    <div class="monitor tile">
      <div class="monitor-label" aria-hidden="true"><span>ECG</span><span>SpO₂</span><span>NIBP</span></div>
      <strong>{copy.monitor}</strong>
      <span>{copy.monitorDetail}</span>
    </div>
    <div class="hint tile"><strong>{copy.hint}</strong><span>{copy.hintDetail}</span></div>
    <div class="actions tile"><strong>{copy.actions}</strong><span>{copy.actionsDetail}</span></div>
  </div>
</figure>

<style>
  .clinic-diagram {
    margin-inline: 0;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: .7rem;
    background: var(--sl-color-bg-sidebar);
    color: var(--sl-color-text);
  }

  figcaption {
    color: var(--sl-color-white);
    font-weight: 700;
    margin-block-end: .7rem;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr) minmax(0, 1.25fr);
    grid-template-areas: "chart patient monitor" "hint actions actions";
    gap: .45rem;
  }

  .tile {
    display: grid;
    align-content: center;
    justify-items: start;
    min-width: 0;
    margin-block: 0;
    padding: .7rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: .4rem;
    background: var(--sl-color-bg);
    font-size: .875rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .tile strong {
    color: var(--sl-color-white);
    font-size: 1rem;
  }

  .chart { grid-area: chart; }
  .patient { grid-area: patient; }
  .monitor { grid-area: monitor; }
  .hint { grid-area: hint; border-color: var(--sl-color-text-accent); }
  .actions { grid-area: actions; }
  .chart, .patient, .monitor { min-height: 9rem; }

  .cot {
    display: flex;
    align-items: center;
    gap: .14rem;
    width: 100%;
    max-width: 10rem;
    height: 2.6rem;
    box-sizing: border-box;
    padding: .4rem .6rem;
    margin-block-end: .55rem;
    border: 2px solid #838577;
    border-block-end: 4px solid #6a776e;
    background: #c6c6a7;
  }

  .cot i { display: block; height: .85rem; margin: 0; background: #455958; border: 1px solid #3a4a4d; }
  .cot i:first-child { flex: 0 1 1rem; height: 1rem; border-radius: 40%; background: #a17c63; }
  .cot i:nth-child(2) { flex: 0 1 4rem; border-radius: .4rem .18rem .2rem .4rem; }
  .cot i:nth-child(3) { flex: 0 1 3rem; height: .66rem; }

  .monitor-label {
    display: flex;
    flex-wrap: wrap;
    gap: .25rem .55rem;
    margin-block-end: .6rem;
    padding: .35rem .45rem;
    border-radius: .25rem;
    background: #182520;
    color: #bde5cd;
    font-size: .72rem;
    font-family: var(--sl-font-mono);
  }

  .clipboard {
    position: relative;
    width: 2.2rem;
    height: 3rem;
    margin: .25rem 0 .55rem;
    border: .22rem solid #987746;
    background: repeating-linear-gradient(to bottom, #747862 0 2px, transparent 2px 7px) center / 73% 66% no-repeat #dfd1a8;
  }

  .clipboard::before {
    position: absolute;
    inset: -.43rem 25% auto;
    height: .43rem;
    background: #738073;
    content: '';
  }

  @media (max-width: 26rem) {
    .clinic-diagram { padding: .7rem; }
    .tile { padding: .55rem; }
    .layout {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas: "patient patient" "chart monitor" "hint hint" "actions actions";
    }
    .patient { min-height: 0; }
  }
</style>
